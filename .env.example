# Copy to .env and fill in your values
DATABASE_URL=postgresql://jobscope:jobscope@localhost:5432/jobscope
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# Base URL for server-side fetches to internal API routes
# (optional — falls back to relative paths if unset)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Ingestion trigger auth (protects POST /api/ingest)
INGEST_SECRET=change-me-before-production

# Job source APIs (free tiers)
ADZUNA_APP_ID=
ADZUNA_API_KEY=
REED_API_KEY=
JOOBLE_API_KEY=
# JSearch (Google Jobs aggregator via RapidAPI) — free tier: 200 req/month
# Get your key at https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=
# Active Jobs DB (ATS aggregator: Greenhouse/Lever/Workday via RapidAPI) — free tier: ~100 req/month
# Same RapidAPI key as JSEARCH_API_KEY if using the same subscription
# Get your key at https://rapidapi.com/active-jobs-db/api/active-jobs-db
RAPIDAPI_KEY=

# AI (resume parsing)
ANTHROPIC_API_KEY=

# Cloudflare R2 (optional — resume file storage)
CLOUDFLARE_R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY=
R2_SECRET_KEY=

# Copy to .env and fill in your values
DATABASE_URL=postgresql://jobscope:jobscope@localhost:5432/jobscope
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# Base URL for server-side fetches to internal API routes
# (optional — falls back to relative paths if unset)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Ingestion trigger auth (protects POST /api/ingest)
INGEST_SECRET=change-me-before-production

# Job source APIs (free tiers)
ADZUNA_APP_ID=
ADZUNA_API_KEY=
REED_API_KEY=
JOOBLE_API_KEY=

# AI (resume parsing)
ANTHROPIC_API_KEY=

# Cloudflare R2 (optional — resume file storage)
CLOUDFLARE_R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY=
R2_SECRET_KEY=
